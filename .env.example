# ─── Server ───────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
ORIGIN=https://your-domain.example.com

# ─── Session ──────────────────────────────────────────
# REQUIRED in production — must be changed from default!
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# ─── S3 Defaults (pre-fill login form) ───────────────
# S3_DEFAULT_ENDPOINT=http://localhost:9000
# S3_DEFAULT_PUBLIC_ENDPOINT=   # Browser-facing endpoint, if different (e.g. in-cluster S3)
# S3_DEFAULT_REGION=us-east-1

# ─── Fixed Credentials Mode (skip login form) ────────
# WARNING: All users share these credentials. Only use behind VPN/auth proxy.
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=           # Browser-facing endpoint for presigned URLs, if different
# S3_REGION=us-east-1
# S3_SESSION_TOKEN=

# ─── Single-Bucket Mode ──────────────────────────────
# Restrict the app to ONE specific bucket. Required when your IAM credentials
# don't have s3:ListAllMyBuckets permission (common in shared/corporate setups).
# When set, the bucket sidebar shows only this bucket and bucket create/delete
# UI is hidden. Works with both manual login and fixed credentials.
# S3_BUCKET=tnd-s3

# ─── TLS — internal endpoints with self-signed certs ─
# Set to "true" to skip TLS certificate verification when talking to S3.
# Common case: an internal Ceph/MinIO box reachable by IP whose cert doesn't
# include that IP in its SAN. NEVER enable on the public internet.
# S3_INSECURE_TLS=false

# ─── OIDC / SSO (Okta, Keycloak, Azure AD, etc.) ────
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
